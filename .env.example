# Copy to .env and adjust. All variables are prefixed CFO_ to match
# Settings.model_config in src/cfo_platform/settings.py.

CFO_ENVIRONMENT=development
CFO_LOG_LEVEL=INFO

# Paths are resolved relative to the repo root if not absolute.
CFO_DATA_ROOT=data
CFO_WAREHOUSE_DIR=data/warehouse
CFO_CONFIG_DIR=config
CFO_CLIENTS_CONFIG_DIR=config/clients
CFO_LOGGING_CONFIG_PATH=config/logging.yaml

# Which config/clients/<id>.yaml the CLI defaults to when --client is omitted.
CFO_DEFAULT_CLIENT=mag

# Revenue Summary (PDF) parsing requires Poppler's pdftotext -- Xpdf and other
# clones render -layout column alignment differently and break the parser.
# Leave unset to resolve "pdftotext" from PATH; set this if the right build
# isn't first on PATH (e.g. a conda env's Library/bin).
# CFO_PDFTOTEXT_PATH=C:\Users\you\conda3\Library\bin\pdftotext.exe
